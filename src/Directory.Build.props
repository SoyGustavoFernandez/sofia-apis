<Project>
  <!--
    SonarAnalyzer.CSharp: Roslyn security analyzer.
    Runs at build time. Excluded from test/tooling projects.
    PrivateAssets="all" prevents transitive dependency leakage.
  -->
  <PropertyGroup>
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('Tests'))">true</IsTestProject>
    <SkipSonarAnalyzer Condition="'$(IsTestProject)' == 'true' Or $(MSBuildProjectName.Contains('DbUp'))">true</SkipSonarAnalyzer>
  </PropertyGroup>

  <ItemGroup Condition="'$(SkipSonarAnalyzer)' != 'true'">
    <PackageReference Include="SonarAnalyzer.CSharp"
                      Version="9.32.0.97167"
                      PrivateAssets="all"
                      IncludeAssets="analyzers" />
  </ItemGroup>

</Project>
