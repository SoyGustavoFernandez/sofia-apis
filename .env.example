# Copia este archivo a .env y completa los valores
# cp .env.example .env

# SQL Server
SA_PASSWORD=<REEMPLAZAR_CON_PASSWORD_SEGURO>

# JWT (mínimo 32 caracteres)
JWT_SECRET_KEY=<REEMPLAZAR_CON_CLAVE_JWT_MIN_32_CHARS>

# Shared key between the API and Presidio (optional; empty disables the check)
PRESIDIO_INTERNAL_KEY=

# Google Gemini API
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models/
GEMINI_OCR_MODEL=gemini-3.6-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro
GEMINI_API_KEY=

# Password recovery emails (API keys Email:* and App:FrontendBaseUrl)
# Local: Smtp against the mailpit service (docker compose up -d mailpit), no auth, no TLS
# Azure staging: EMAIL_PROVIDER=AzureCommunication, EMAIL_FROM_ADDRESS=DoNotReply@<guid>.azurecomm.net and the ACS connection string
APP_FRONTEND_BASE_URL=http://localhost:4200
EMAIL_PROVIDER=Smtp
EMAIL_FROM_ADDRESS=no-reply@sofia.local
EMAIL_FROM_DISPLAY_NAME=SOFIA
EMAIL_SMTP_HOST=mailpit
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USE_SSL=false
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_ACS_CONNECTION_STRING=
