{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "tasks": [
      {
         "name": "detect-secrets",
         "group": "pre-commit",
         "command": "bash",
         "args": [
            ".husky/scripts/detect-secrets.sh"
         ]
      },
      {
         "name": "dotnet-format",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [
            "format",
            "--include",
            "${staged}"
         ],
         "include": [
            "**/*.cs",
            "**/*.csproj"
         ]
      },
      {
         "name": "re-stage",
         "group": "pre-commit",
         "command": "git",
         "args": [
            "add",
            "${staged}"
         ]
      },
      {
         "name": "architecture-tests",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [
            "test",
            "src/SOFIA.ArchitectureTests/SOFIA.ArchitectureTests.csproj",
            "--configuration",
            "Release",
            "--no-restore"
         ]
      },
      {
         "name": "commit-message-validator",
         "group": "commit-msg",
         "command": "dotnet",
         "args": [
            "husky",
            "exec",
            ".husky/scripts/validate-commit-msg.csx",
            "--args",
            "${args}"
         ]
      }
   ]
}
