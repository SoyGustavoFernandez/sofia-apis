root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
# C# Coding Conventions
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0008.severity = warning # Use var instead of explicit type (when type is evident)
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:error
csharp_style_var_elsewhere = true:suggestion

# Namespace declarations
csharp_style_namespace_declarations = file_scoped:error

# Modifier preferences
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:error

# New lines
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true

# Indentation
cpp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current

# Style
csharp_prefer_braces = true:suggestion
csharp_style_expression_bodied_methods = true:suggestion
dotnet_style_prefer_conditional_expression_over_return = false
csharp_style_expression_bodied_constructors = true:suggestion
csharp_style_expression_bodied_operators = true:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_indexers = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

# Analyzers
dotnet_analyzer_diagnostic.category-Style.severity = warning
dotnet_analyzer_diagnostic.category-CodeQuality.severity = warning

# Formato estricto como error de compilación
dotnet_diagnostic.IDE0055.severity = error
dotnet_style_allow_multiple_blank_lines_experimental = false:error

# ── SonarAnalyzer — Security rules (build errors) ────────────────────────────
# SQL Injection
dotnet_diagnostic.S2077.severity = error
# OS Command Injection
dotnet_diagnostic.S2076.severity = error
# Path Traversal
dotnet_diagnostic.S2083.severity = error
# LDAP Injection
dotnet_diagnostic.S2078.severity = error
# XPath Injection
dotnet_diagnostic.S2091.severity = error
# HTTP Response Splitting
dotnet_diagnostic.S5131.severity = error
# Hardcoded credentials
dotnet_diagnostic.S2068.severity = error
# Weak cryptography
dotnet_diagnostic.S2278.severity = error
dotnet_diagnostic.S4426.severity = error
# JWT without signature / weak algorithm
dotnet_diagnostic.S5659.severity = error
# Overly permissive CORS policy
dotnet_diagnostic.S5122.severity = error
# Cookie missing HttpOnly / Secure flag
dotnet_diagnostic.S2092.severity = error
dotnet_diagnostic.S3330.severity = error
# Insecure deserialization
dotnet_diagnostic.S5135.severity = error
# XML External Entity (XXE)
dotnet_diagnostic.S2755.severity = error
# ── SonarAnalyzer — Code quality (warnings) ──────────────────────────────────
dotnet_diagnostic.S101.severity = warning
dotnet_diagnostic.S1135.severity = warning
dotnet_diagnostic.S3358.severity = warning
dotnet_diagnostic.S3776.severity = warning
dotnet_diagnostic.S4457.severity = warning
dotnet_diagnostic.S6602.severity = warning
