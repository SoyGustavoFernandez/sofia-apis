# Copia este archivo a .env y completa los valores
# cp .env.example .env

# SQL Server
SA_PASSWORD=<REEMPLAZAR_CON_PASSWORD_SEGURO>

# JWT (mínimo 32 caracteres)
JWT_SECRET_KEY=<REEMPLAZAR_CON_CLAVE_JWT_MIN_32_CHARS>

# Google Gemini API
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_OCR_MODEL=gemini-1.5-flash
GEMINI_REASONING_MODEL=gemini-1.5-pro
GEMINI_API_KEY=
